---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHidden = pathname === "/kontakt";
---

{!isHidden && (
  <a
    href="/kontakt"
    data-floating-book
    class="floating-book fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 rounded-full bg-copper-dark px-5 py-3 text-sm font-semibold text-cream shadow-lg shadow-graphite/20 hover:bg-copper transition-colors sm:bottom-6 sm:right-6"
  >
    Zarezerwuj
  </a>
)}
