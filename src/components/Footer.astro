---
import DotLine from "./DotLine.astro";
import { categories } from "../data/categories";

const year = new Date().getFullYear();
---

<footer class="bg-graphite text-cream">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-serif text-2xl font-semibold">ELARA</p>
        <DotLine class="my-3" />
        <p class="text-sm text-cream/70">Twój czas na piękno.</p>
        <p class="mt-4 text-sm text-cream/70">
          ul. Świętojańska 82<br />
          81-401 Gdynia
        </p>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-cream/50">Usługi</p>
        <ul class="space-y-2 text-sm text-cream/80">
          {categories.map((category) => (
            <li>
              <a href={`/uslugi/${category.slug}`} class="hover:text-copper transition-colors">
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-cream/50">Instytut</p>
        <ul class="space-y-2 text-sm text-cream/80">
          <li><a href="/vouchery" class="hover:text-copper transition-colors">Vouchery</a></li>
          <li><a href="/promocje" class="hover:text-copper transition-colors">Promocje</a></li>
          <li><a href="/zespol" class="hover:text-copper transition-colors">Zespół</a></li>
          <li><a href="/o-nas" class="hover:text-copper transition-colors">O nas</a></li>
          <li><a href="/pierwsza-wizyta" class="hover:text-copper transition-colors">Pierwsza wizyta</a></li>
          <li><a href="/kontakt" class="hover:text-copper transition-colors">Kontakt</a></li>
        </ul>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-cream/50">Kontakt</p>
        <ul class="space-y-2 text-sm text-cream/80">
          <li>
            <a href="tel:+48512340219" class="hover:text-copper transition-colors">512 340 219</a>
          </li>
          <li>
            <a href="mailto:rezerwacje@elara-beauty.pl" class="hover:text-copper transition-colors">
              rezerwacje@elara-beauty.pl
            </a>
          </li>
          <li class="pt-2 text-cream/60">Pon–Sob 9:00–20:00</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-cream/10 pt-6 text-xs text-cream/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} ELARA · Strona demonstracyjna Connectiva · Polityka prywatności</p>
    </div>
  </div>
</footer>
