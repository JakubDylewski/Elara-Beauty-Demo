---
import DotLine from "../DotLine.astro";
---

<section class="bg-cream">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
    <DotLine class="justify-center" />
    <h2 class="mt-4 font-serif text-3xl font-semibold text-graphite sm:text-4xl">
      Podaruj komuś godzinę dla siebie
    </h2>
    <p class="mt-3 text-graphite-soft">Voucher ważny 12 miesięcy, elegancko zapakowany.</p>
    <a
      href="/vouchery"
      class="mt-6 inline-block rounded-full bg-copper px-8 py-3.5 font-semibold text-cream hover:bg-copper-dark transition-colors"
    >
      Skomponuj prezent →
    </a>
  </div>
</section>
