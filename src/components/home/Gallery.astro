---
import ImagePlaceholder from "../ImagePlaceholder.astro";

const works = [
  { label: "Paznokcie · manicure hybrydowy" },
  { label: "Paznokcie · przedłużanie żelowe" },
  { label: "Brwi · laminacja i henna" },
  { label: "Rzęsy · lifting" },
  { label: "Makijaż · stylizacja na wyjście" },
  { label: "Pielęgnacja twarzy · oczyszczanie" },
];
---

<section class="relative mt-16 overflow-x-hidden" data-gallery-section>
  <div class="thread-section-bg bg-blush" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-center font-serif text-3xl font-semibold text-graphite sm:text-4xl">
      Metamorfozy i galeria prac
    </h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {works.map((work, index) => (
        <div data-cascade style={`transition-delay: ${Math.min(index * 80, 480)}ms`}>
          <div data-gallery-item data-index={index} style={`transition-delay: ${index * 120}ms`}>
            <ImagePlaceholder label={work.label} aspect="aspect-square" tone="cream" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* 14B — mobile: alternating side entrance replaces the scroll-linked
     diverge (which used to push edge-to-edge single-column items partway
     off a narrow screen). Odd items (1,3,5) enter from the left, even
     (2,4,6) from the right, land once, and stay. */
  @media (max-width: 767px) {
    [data-gallery-section] [data-cascade] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    [data-gallery-item] {
      opacity: 0;
      transition: opacity 500ms ease-out, transform 500ms ease-out;
    }

    [data-gallery-item][data-index="0"],
    [data-gallery-item][data-index="2"],
    [data-gallery-item][data-index="4"] {
      transform: translateX(-100%);
    }

    [data-gallery-item][data-index="1"],
    [data-gallery-item][data-index="3"],
    [data-gallery-item][data-index="5"] {
      transform: translateX(100%);
    }

    [data-cascade].is-visible [data-gallery-item] {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-gallery-item] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector("[data-gallery-section]");
  const items = Array.from(document.querySelectorAll("[data-gallery-item]"));

  if (section instanceof HTMLElement && items.length > 0) {
    const desktopQuery = window.matchMedia("(min-width: 768px)");
    let inView = false;

    const observer = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        items.forEach((el) => {
          if (el instanceof HTMLElement) el.style.willChange = inView && desktopQuery.matches ? "transform" : "";
        });
      },
      { rootMargin: "50% 0px 50% 0px" }
    );
    observer.observe(section);

    window.elaraMotion?.register(({ reducedMotion }) => {
      if (reducedMotion) {
        items.forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          el.style.transform = "";
          el.style.willChange = "";
        });
        return;
      }
      if (!desktopQuery.matches) {
        // 14B: below 768px the CSS-driven side entrance owns transform/opacity.
        items.forEach((el) => {
          if (el instanceof HTMLElement && el.style.transform) el.style.transform = "";
        });
        return;
      }
      if (!inView) return;

      const rect = section.getBoundingClientRect();
      const ih = window.innerHeight;
      const p = Math.min(1, Math.max(0, (ih * 0.85 - rect.top) / (ih * 0.5)));

      items.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const index = Number(el.dataset.index);
        const dir = index < 3 ? -1 : 1;
        el.style.transform = `translate3d(${dir * 160 * p}px, 0, 0)`;
      });
    });
  }
</script>
