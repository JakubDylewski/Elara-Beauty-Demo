---
const stats = [
  { value: "8 lat", label: "w Gdyni" },
  { value: "4,9/5", label: "380 opinii Google" },
  { value: "12 000+", label: "wykonanych zabiegów" },
  { value: "6", label: "specjalistek" },
];
---

<section class="bg-blush">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 text-center sm:px-6 lg:grid-cols-4">
    {stats.map((stat) => (
      <div>
        <p class="font-serif text-2xl font-semibold text-graphite sm:text-3xl">{stat.value}</p>
        <p class="mt-1 text-sm text-graphite-soft">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
