---
import DotLine from "../DotLine.astro";
import ImagePlaceholder from "../ImagePlaceholder.astro";
---

<section class="hero relative overflow-x-hidden lg:max-h-[82vh] lg:overflow-hidden" data-hero>
  <div class="thread-section-bg bg-cream" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-5 lg:gap-12 lg:py-24">
    <div class="lg:col-span-3" data-hero-text>
      <DotLine />
      <p class="mt-4 text-sm font-medium uppercase tracking-widest text-graphite-soft">
        Instytut Urody · Gdynia Świętojańska
      </p>
      <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight text-graphite sm:text-5xl lg:text-6xl">
        Twój czas na piękno.
      </h1>
      <p class="mt-5 max-w-lg text-lg text-graphite-soft">
        Paznokcie, rzęsy, twarz i ciało — pod jednym dachem, w rękach specjalistek, które robią to od lat.
      </p>
      <div class="mt-8">
        <a
          href="/kontakt"
          class="inline-block rounded-full bg-copper-dark px-8 py-4 font-semibold text-cream hover:bg-copper transition-colors"
        >
          Zarezerwuj wizytę
        </a>
        <p class="mt-3 text-sm text-graphite-soft">
          lub zadzwoń:
          <a href="tel:+48512340219" class="font-medium text-copper-dark hover:text-copper transition-colors">
            512 340 219
          </a>
        </p>
      </div>
    </div>

    <div class="lg:col-span-2 overflow-visible">
      <div class="mx-auto flex flex-col items-center gap-2.5 overflow-visible lg:gap-4" data-hero-mosaic>
        <div class="w-[118px] lg:w-[190px]" data-hero-tile="a">
          <ImagePlaceholder label="Pielęgnacja twarzy · relaks" aspect="aspect-[4/5]" tone="blush" class="shadow-sm" />
        </div>
        <div class="flex gap-2.5 lg:gap-4">
          <div class="w-[75px] lg:w-[120px]" data-hero-tile="b">
            <ImagePlaceholder label="Stylizacja paznokci" aspect="aspect-square" tone="blush" class="shadow-sm" />
          </div>
          <div class="w-[75px] translate-y-1.5 lg:w-[120px] lg:translate-y-3.5" data-hero-tile="c">
            <ImagePlaceholder label="Brwi i rzęsy" aspect="aspect-square" tone="blush" class="shadow-sm" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const heroText = document.querySelector("[data-hero-text]");
  const tileA = document.querySelector('[data-hero-tile="a"]');
  const tileB = document.querySelector('[data-hero-tile="b"]');
  const tileC = document.querySelector('[data-hero-tile="c"]');

  if (
    heroText instanceof HTMLElement &&
    tileA instanceof HTMLElement &&
    tileB instanceof HTMLElement &&
    tileC instanceof HTMLElement
  ) {
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    const EXIT_BUFFER = 60;
    const tiles = [
      { el: tileA, rate: 1.0, naturalLeft: 0 },
      { el: tileB, rate: 1.15, naturalLeft: 0 },
      { el: tileC, rate: 1.35, naturalLeft: 0 },
    ];

    function easeOutQuad(p) {
      return p * (2 - p);
    }

    function resetEl(el) {
      el.style.willChange = "";
      el.style.transform = "";
      el.style.opacity = "";
    }

    function measureTiles() {
      tiles.forEach((tile) => {
        const prevTransform = tile.el.style.transform;
        tile.el.style.transform = "";
        tile.naturalLeft = tile.el.getBoundingClientRect().left;
        tile.el.style.transform = prevTransform;
      });
    }

    function updateTile(tile, eased, opacity, scale, active) {
      const clearDistance = Math.max(window.innerWidth - tile.naturalLeft + EXIT_BUFFER, 0);
      const tileEased = Math.min(1, eased * tile.rate);
      tile.el.style.willChange = active ? "transform, opacity" : "";
      tile.el.style.transform = `translate3d(${clearDistance * tileEased}px, 0, 0) scale(${scale})`;
      tile.el.style.opacity = String(opacity);
    }

    measureTiles();

    let resizeTimer;
    window.addEventListener(
      "resize",
      () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(measureTiles, 150);
      },
      { passive: true }
    );

    window.elaraMotion?.register(({ scrollY, reducedMotion }) => {
      if (reducedMotion) {
        resetEl(heroText);
        tiles.forEach((tile) => resetEl(tile.el));
        return;
      }

      const range = window.innerHeight * 0.65;
      const p = Math.min(Math.max(scrollY / range, 0), 1);
      const eased = easeOutQuad(p);
      const active = p > 0 && p < 1;
      const textDistance = desktopQuery.matches ? -220 : -120;
      const opacity = 1 - eased * 0.85;
      const scale = 1 - eased * 0.06;

      heroText.style.willChange = active ? "transform, opacity" : "";
      heroText.style.transform = `translate3d(${textDistance * eased}px, 0, 0)`;
      heroText.style.opacity = String(opacity);

      tiles.forEach((tile) => updateTile(tile, eased, opacity, scale, active));
    });
  }
</script>
