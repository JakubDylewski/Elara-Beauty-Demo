---
import { testimonials } from "../../data/testimonials";
---

<section class="relative mt-16 overflow-x-hidden" data-testimonials-section>
  <div class="thread-section-bg bg-blush" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-center font-serif text-3xl font-semibold text-graphite sm:text-4xl">Opinie</h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((review, index) => (
        <div data-cascade style={`transition-delay: ${Math.min(index * 80, 480)}ms`}>
          <div class="rounded-2xl bg-cream p-6" data-testimonial-item data-index={index}>
            <div class="text-copper" aria-hidden="true">{"★".repeat(review.stars)}</div>
            <p class="mt-3 text-sm text-graphite">{review.text}</p>
            <p class="mt-4 text-sm font-semibold text-graphite">{review.name}</p>
            <p class="text-xs text-graphite-soft">opinia Google</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.querySelector("[data-testimonials-section]");
  const items = Array.from(document.querySelectorAll("[data-testimonial-item]"));

  if (section instanceof HTMLElement && items.length > 0) {
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    let inView = false;

    const observer = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        items.forEach((el) => {
          if (el instanceof HTMLElement) el.style.willChange = inView ? "transform" : "";
        });
      },
      { rootMargin: "50% 0px 50% 0px" }
    );
    observer.observe(section);

    window.elaraMotion?.register(({ reducedMotion }) => {
      if (reducedMotion) {
        items.forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          el.style.transform = "";
          el.style.willChange = "";
        });
        return;
      }
      if (!inView) return;

      const rect = section.getBoundingClientRect();
      const ih = window.innerHeight;
      const p = Math.min(1, Math.max(0, (ih * 0.85 - rect.top) / (ih * 0.5)));
      const distance = desktopQuery.matches ? 160 : 90;

      items.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const index = Number(el.dataset.index);
        const dir = index < 3 ? -1 : 1;
        el.style.transform = `translate3d(${dir * distance * p}px, 0, 0)`;
      });
    });
  }
</script>
