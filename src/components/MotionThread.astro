---
---

<svg
  id="elara-thread"
  class="absolute inset-0 z-[5]"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path id="thread-thick" fill="none" stroke="#B5654A" stroke-linecap="round" opacity="0"></path>
  <path id="thread-line" fill="none" stroke="#B5654A" stroke-width="1.5"></path>
  <g id="thread-dot">
    <path
      fill="var(--color-blush)"
      stroke="var(--color-copper)"
      stroke-width="0.75"
      d="M 0,-9 C 4,-9 5,-4 5,2 A 5,5 0 0 1 -5,2 C -5,-4 -4,-9 0,-9 Z"
    ></path>
    <path fill="#ffffff" d="M -3.8,4 A 4.6,4.6 0 0 0 3.8,4 A 3.6,3.6 0 0 1 -3.8,4 Z"></path>
  </g>
</svg>

<script>
  const svg = document.getElementById("elara-thread");
  const wrapper = document.getElementById("page-thread-wrapper");
  const linePath = document.getElementById("thread-line");
  const thickPath = document.getElementById("thread-thick");
  const dot = document.getElementById("thread-dot");

  if (
    svg instanceof SVGSVGElement &&
    wrapper instanceof HTMLElement &&
    linePath instanceof SVGPathElement &&
    thickPath instanceof SVGPathElement &&
    dot instanceof SVGGElement
  ) {
    const WINDOW_LEN = 140;
    const TANGENT_EPSILON = 2;
    let totalLength = 0;
    let lastProgress = 0;

    function buildPath() {
      const mobile = window.matchMedia("(max-width: 767px)").matches;
      const width = Math.max(wrapper.clientWidth, 1);
      const height = Math.max(wrapper.scrollHeight, 1);

      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);

      const amplitude = width * (mobile ? 0.06 : 0.12);
      // Mobile content is single-column and near-edge-to-edge, so the thread's
      // center-crossing points otherwise land on nearly every stacked heading.
      // A longer wavelength spreads those crossings out so it doesn't read as
      // "checking off" each list item in a row.
      const wavelength = window.innerHeight * (mobile ? 1.6 : 0.9);
      const halfWave = Math.max(wavelength / 2, 1);
      const centerX = width / 2;

      let d = `M ${centerX} 0`;
      let prevX = centerX;
      let prevY = 0;
      let y = 0;
      let dir = 1;

      while (y < height) {
        const nextY = Math.min(y + halfWave, height);
        const reachedEdge = y + halfWave > height;
        const targetX = reachedEdge ? centerX : centerX + amplitude * dir;
        const midY = prevY + (nextY - prevY) / 2;
        d += ` C ${prevX} ${midY}, ${targetX} ${midY}, ${targetX} ${nextY}`;
        prevX = targetX;
        prevY = nextY;
        y = nextY;
        dir *= -1;
      }

      linePath.setAttribute("d", d);
      thickPath.setAttribute("d", d);
      linePath.setAttribute("stroke-width", mobile ? "1" : "1.5");
      thickPath.setAttribute("stroke-width", mobile ? "3" : "4");

      totalLength = linePath.getTotalLength();
      thickPath.setAttribute("stroke-dasharray", `${WINDOW_LEN} ${Math.max(totalLength - WINDOW_LEN, 0)}`);
    }

    function setProgress(progress) {
      if (!totalLength) return;
      const clamped = Math.min(Math.max(progress, 0), 1);
      const len = clamped * totalLength;
      const point = linePath.getPointAtLength(len);

      const aheadLen = Math.min(len + TANGENT_EPSILON, totalLength);
      const behindLen = Math.max(len - TANGENT_EPSILON, 0);
      const ahead = linePath.getPointAtLength(aheadLen);
      const behind = linePath.getPointAtLength(behindLen);
      const angle = Math.atan2(ahead.x - behind.x, ahead.y - behind.y) * (180 / Math.PI);

      dot.setAttribute("transform", `translate(${point.x}, ${point.y}) rotate(${angle})`);

      const offset = totalLength - len + WINDOW_LEN / 2;
      thickPath.setAttribute("stroke-dashoffset", String(offset));
    }

    buildPath();
    setProgress(0);

    const reducedMotion = window.elaraMotion?.reducedMotion;
    const lowPower = window.elaraMotion?.lowPower;

    if (!reducedMotion && !lowPower) {
      thickPath.style.opacity = "0.9";
    }

    const resizeObserver = new ResizeObserver(() => {
      buildPath();
      setProgress(lastProgress);
    });
    resizeObserver.observe(wrapper);

    window.addEventListener("load", () => {
      buildPath();
      setProgress(lastProgress);
    });

    if (!reducedMotion) {
      window.elaraMotion?.register(({ scrollY }) => {
        const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        lastProgress = scrollY / max;
        setProgress(lastProgress);
      });
    }
  }
</script>
