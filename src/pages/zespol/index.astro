---
import Base from "../../layouts/Base.astro";
import DotLine from "../../components/DotLine.astro";
import ImagePlaceholder from "../../components/ImagePlaceholder.astro";
import { team } from "../../data/team";
import { services } from "../../data/services";
import { categories } from "../../data/categories";

const categoryName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
---

<Base
  title="Zespół"
  description="Poznaj zespół ELARA — specjalistki od paznokci, rzęs i brwi, twarzy, depilacji, masaży i makijażu w Gdyni."
>
  <section class="relative">
    <div class="thread-section-bg bg-cream" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 sm:py-16">
      <DotLine class="justify-center" />
      <h1 class="mt-4 font-serif text-4xl font-semibold text-graphite sm:text-5xl">Zespół</h1>
      <p class="mx-auto mt-3 max-w-xl text-graphite-soft">
        Sześć specjalistek, jedna filozofia: efekt ma być widoczny, a wizyta — momentem tylko dla Ciebie.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="thread-section-bg bg-blush" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((member) => {
          const memberServices = services.filter((s) => s.categorySlug === member.categorySlug).slice(0, 4);
          const totalInCategory = services.filter((s) => s.categorySlug === member.categorySlug).length;
          const remaining = totalInCategory - memberServices.length;
          return (
            <div class="flex flex-col rounded-2xl bg-cream p-6">
              <ImagePlaceholder label={member.name} aspect="aspect-[4/5]" tone="blush" />
              <p class="mt-5 font-serif text-2xl font-semibold text-graphite">{member.name}</p>
              <p class="text-sm font-medium text-copper-dark">{member.specialization}</p>
              <p class="mt-3 text-sm text-graphite-soft">{member.bio}</p>

              <ul class="mt-4 space-y-1.5 border-t border-graphite/10 pt-4 text-sm">
                {memberServices.map((service) => (
                  <li class="flex items-center justify-between gap-3">
                    <span class="text-graphite">{service.name}</span>
                    <span class="shrink-0 font-medium text-copper-dark">{service.price} zł</span>
                  </li>
                ))}
              </ul>

              <a
                href={`/uslugi/${member.categorySlug}`}
                class="mt-4 text-sm font-semibold text-copper-dark hover:text-copper transition-colors"
              >
                {remaining > 0
                  ? `Zobacz pełną ofertę: ${categoryName(member.categorySlug)} (+${remaining}) →`
                  : `Zobacz pełną ofertę: ${categoryName(member.categorySlug)} →`}
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="thread-section-bg bg-cream" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <h2 class="font-serif text-3xl font-semibold text-graphite sm:text-4xl">Umów się z wybraną specjalistką</h2>
      <p class="mx-auto mt-3 max-w-lg text-graphite-soft">
        W formularzu rezerwacji możesz wskazać, u kogo chcesz się umówić — postaramy się dopasować termin.
      </p>
      <a
        href="/kontakt"
        class="mt-6 inline-block rounded-full bg-copper px-8 py-4 font-semibold text-cream hover:bg-copper-dark transition-colors"
      >
        Zarezerwuj wizytę
      </a>
    </div>
  </section>
</Base>
