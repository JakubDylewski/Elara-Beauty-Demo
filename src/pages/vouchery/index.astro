---
import Base from "../../layouts/Base.astro";
import DotLine from "../../components/DotLine.astro";
import { voucherAmounts, voucherPackages } from "../../data/vouchers";
---

<Base title="Vouchery i pakiety" description="Voucher podarunkowy ELARA — podaruj czas na piękno. Vouchery kwotowe i pakiety-przeżycia, ważne 12 miesięcy.">
  <section class="relative">
    <div class="thread-section-bg bg-cream" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 sm:py-16">
      <DotLine class="justify-center" />
      <h1 class="mt-4 font-serif text-4xl font-semibold text-graphite sm:text-5xl">Podaruj czas na piękno</h1>
      <p class="mx-auto mt-3 max-w-xl text-graphite-soft">
        Elegancki voucher podarunkowy albo gotowy pakiet zabiegów — wybierz formę, która najlepiej pasuje do okazji.
      </p>
    </div>
  </section>

  <section class="relative">
    <div class="thread-section-bg bg-cream" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-5xl px-4 pb-16 sm:px-6 sm:pb-20">
      <h2 class="font-serif text-2xl font-semibold text-graphite sm:text-3xl">Vouchery kwotowe</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {voucherAmounts.map((amount) => (
          <div class="flex flex-col">
            <div class="rounded-2xl bg-graphite p-6 text-cream">
              <p class="text-xs uppercase tracking-widest text-cream/60">Voucher podarunkowy</p>
              <p class="mt-8 font-serif text-4xl font-semibold">{amount} zł</p>
              <div class="mt-10 flex items-center justify-between">
                <span class="font-serif text-lg tracking-wide">ELARA</span>
                <DotLine />
              </div>
            </div>
            <a
              href={`/kontakt?voucher=${amount}-zl`}
              class="mt-4 inline-block rounded-full bg-copper px-5 py-2.5 text-center text-sm font-semibold text-cream hover:bg-copper-dark transition-colors"
            >
              Zamawiam voucher
            </a>
          </div>
        ))}

        <div class="flex flex-col">
          <div class="rounded-2xl border border-copper/30 bg-blush p-6 text-graphite">
            <p class="text-xs uppercase tracking-widest text-graphite-soft">Voucher podarunkowy</p>
            <p class="mt-8 font-serif text-3xl font-semibold">Dowolna kwota</p>
            <div class="mt-10 flex items-center justify-between">
              <span class="font-serif text-lg tracking-wide">ELARA</span>
              <DotLine />
            </div>
          </div>
          <a
            href="/kontakt?voucher=dowolna-kwota"
            class="mt-4 inline-block rounded-full bg-copper px-5 py-2.5 text-center text-sm font-semibold text-cream hover:bg-copper-dark transition-colors"
          >
            Wpisuję własną kwotę
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="thread-section-bg bg-blush" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="font-serif text-2xl font-semibold text-graphite sm:text-3xl">Pakiety-przeżycia</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {voucherPackages.map((pkg) => (
          <div class="flex flex-col rounded-2xl bg-cream p-6">
            <p class="font-serif text-xl font-semibold text-graphite">{pkg.name}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-graphite-soft">
              {pkg.includes.map((item) => (
                <li>· {item}</li>
              ))}
            </ul>
            <div class="mt-6 flex items-baseline gap-2">
              <span class="text-sm text-graphite-soft line-through">{pkg.regularPrice} zł</span>
              <span class="font-serif text-2xl font-semibold text-copper-dark">{pkg.packagePrice} zł</span>
              <span class="text-xs font-semibold text-copper-dark">{pkg.discountLabel}</span>
            </div>
            <a
              href={`/kontakt?voucher=${pkg.slug}`}
              class="mt-4 inline-block rounded-full bg-copper px-5 py-2.5 text-center text-sm font-semibold text-cream hover:bg-copper-dark transition-colors"
            >
              Zamawiam pakiet
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <div class="thread-section-bg bg-cream" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <h2 class="font-serif text-2xl font-semibold text-graphite sm:text-3xl">Planujesz wieczór panieński?</h2>
      <p class="mt-3 text-graphite-soft">Napisz — ułożymy program dla całej ekipy.</p>
      <a
        href="/kontakt?cel=event"
        class="mt-6 inline-block rounded-full bg-copper px-8 py-3.5 font-semibold text-cream hover:bg-copper-dark transition-colors"
      >
        Zapytaj o program
      </a>
    </div>
  </section>

  <section class="relative">
    <div class="thread-section-bg bg-blush" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-4 py-10 text-center sm:px-6">
      <p class="text-sm text-graphite-soft">
        Voucher ważny 12 miesięcy od daty zakupu. Termin wizyty rezerwujesz telefonicznie lub przez formularz kontaktowy.
      </p>
    </div>
  </section>
</Base>
