---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingBookButton from "../components/FloatingBookButton.astro";
import MotionController from "../components/MotionController.astro";
import RevealController from "../components/RevealController.astro";
import MotionThread from "../components/MotionThread.astro";
import DemoNoticeModal from "../components/DemoNoticeModal.astro";

// Preloaded so the swap from fallback to webfont happens before large text
// blocks (e.g. the full price list on /uslugi) finish laying out — avoids the
// cumulative layout shift a late font swap causes on text-heavy pages.
import figtreeRegularLatin from "@fontsource/figtree/files/figtree-latin-400-normal.woff2?url";
import figtreeRegularLatinExt from "@fontsource/figtree/files/figtree-latin-ext-400-normal.woff2?url";
import frauncesSemiboldLatin from "@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url";
import frauncesSemiboldLatinExt from "@fontsource/fraunces/files/fraunces-latin-ext-600-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const {
  title,
  description = "ELARA — Instytut Urody w Gdyni. Paznokcie, rzęsy, twarz i ciało pod jednym dachem.",
  jsonLd,
  robots,
} = Astro.props;

const pageTitle = `${title} · ELARA Instytut Urody`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" as="font" type="font/woff2" href={figtreeRegularLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={figtreeRegularLatinExt} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesSemiboldLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesSemiboldLatinExt} crossorigin="anonymous" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ELARA Instytut Urody" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <MotionController />
    <RevealController />
    <DemoNoticeModal />
    <Header />
    <div class="relative isolate flex-1" id="page-thread-wrapper">
      <MotionThread />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
    <FloatingBookButton />
  </body>
</html>
