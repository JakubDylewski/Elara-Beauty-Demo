---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingBookButton from "../components/FloatingBookButton.astro";
import MotionController from "../components/MotionController.astro";
import RevealController from "../components/RevealController.astro";
import MotionThread from "../components/MotionThread.astro";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const {
  title,
  description = "ELARA — Instytut Urody w Gdyni. Paznokcie, rzęsy, twarz i ciało pod jednym dachem.",
  jsonLd,
  robots,
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title} · ELARA Instytut Urody</title>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <MotionController />
    <RevealController />
    <Header />
    <div class="relative isolate flex-1" id="page-thread-wrapper">
      <MotionThread />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
    <FloatingBookButton />
  </body>
</html>
